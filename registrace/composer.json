{
    "name": "bkludgerovice/registrace",
    "description": "BKL Registrace – registrační systém Běžeckého klubu Ludgeřovice",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "ext-zlib": "*",
        "phpmailer/phpmailer": "^6.9",
        "chillerlan/php-qrcode": "^5.0",
        "openspout/openspout": "^4.24"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Bkl\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "Bkl\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "sort-packages": true
    }
}
