# BKL Registrace – vše jde přes index.php, interní složky jsou pro web zakázané.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|config|migrations|storage|templates|tests|vendor|cli)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^assets/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(json|lock|md|xml|dist|sql|gz|enc|log|eml|sh|yml|yaml|ini|bak)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(?!index\.php$).+\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(css|js|svg|png)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
